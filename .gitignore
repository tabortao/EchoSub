# 内置词典 dict 目录（v1.3.11：ecdict.csv 直接进 git，省去 CI 下载步骤）
#   - 用户可手动替换为更新版本，git pull 后镜像自动使用新文件
#   - 文件较大（~63 MB），GitHub 会 warn 但可接受
backend/data/dict/ecdict.csv.gh-pages/
backend/data/dict/*.tmp
backend/data/dict/*.partial

# Frontend
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
# v1.3.10：vite-plugin-pwa dev 模式产物（dev server 自动生成的 SW / manifest）
#   不同于 dist/（生产构建），dev-dist 是 pnpm dev 期间实时生成
#   与 dist/ 一律不进 git
frontend/dev-dist/
frontend/.env.local
frontend/.env.*.local
frontend/*.local

